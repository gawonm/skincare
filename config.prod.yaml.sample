# 배포용 config.yaml 예시. config.yaml 으로 복사한 뒤 실제 값을 넣는다.
# 이 파일은 저장소에 커밋되므로 실제 비밀값을 적지 않는다. config.yaml 은 .gitignore 대상이다.
#
# 로컬 개발용은 config.yaml.sample 을 쓴다. 둘의 차이는 호스트 이름과 쿠키 설정뿐이다.
# 컨테이너 안에서 localhost 는 자기 자신이라 DB 에 닿지 않는다. compose 서비스 이름을 쓴다.

database:
  # localhost 가 아니라 서비스 이름 postgres. 포트는 컨테이너 내부 포트인 5432 고정이다.
  # 호스트에 매핑한 POSTGRES_PORT 와는 무관하다.
  url: postgresql+asyncpg://app:app@postgres:5432/app

  model_modules:
    - models.evidence
    - models.ingredient
    - models.ingredient_knowledge
    - models.product
    - models.product_ingredient
    - models.rag_chunk
    - models.user

redis:
  # 마찬가지로 서비스 이름 redis.
  url: redis://redis:6379/0
  max_connections: 20
  decode_responses: true

app:
  title: skincare

auth:
  session_ttl_seconds: 1209600
  cookie_name: session_id
  # HTTPS 뒤에 두면 반드시 true 로 바꾼다. http 로 그대로 노출한다면 false 여야 쿠키가 붙는다.
  cookie_secure: false
  cookie_samesite: lax
  cookie_domain: null

# 배포 컨테이너는 MFDS 수집 스크립트를 실행하지 않으므로 mfds 블록이 없어도 된다.
# 컨테이너 안에서 그 스크립트를 돌릴 일이 생기면 그때 추가한다.

# 실제 키는 이 샘플이 아니라 배포 호스트의 config.yaml에만 입력한다.
openai:
  api_key: "OpenAI API 키"
  chat_model: gpt-4o-mini
  timeout_seconds: 30
  max_retries: 1

agent:
  embedding:
    # 현재 DB vector(1536)와 기존 색인을 그대로 사용한다.
    provider: openai
    openai_model: text-embedding-3-small
    openai_dimensions: 1536
    openai_batch_size: 100
    # provider: local을 선택할 때 사용하는 설정이다.
    model: BAAI/bge-m3
    device: null
    batch_size: 16
    cache_folder: null
    local_files_only: false
  reranker:
    model: BAAI/bge-reranker-v2-m3
    device: null
    batch_size: 8
    max_length: 512
    cache_folder: null
    local_files_only: false
  retrieval:
    free_text_min_vector_similarity: 0.45
    rrf_k: 60
    rerank_candidate_limit: 30
