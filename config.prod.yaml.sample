# 배포용 설정 예시. config.prod.yaml 으로 복사한 뒤 실제 값을 넣는다.
# 파일명이 config.yaml 이 아닌 이유는 개발용 config.yaml(localhost 주소)과 한 머신에
# 공존할 수 있어야 하기 때문이다. docker-compose.prod.yml 이 이 파일을 컨테이너 안의
# /app/config.yaml 로 마운트한다.
# 이 파일은 저장소에 커밋되므로 실제 비밀값을 적지 않는다. config.prod.yaml 은 .gitignore 대상이다.
#
# 로컬 개발용은 config.yaml.sample 을 쓴다. 둘의 차이는 호스트 이름과 쿠키 설정뿐이다.
# 컨테이너 안에서 localhost 는 자기 자신이라 DB 에 닿지 않는다. compose 서비스 이름을 쓴다.

database:
  # localhost 가 아니라 서비스 이름 postgres. 포트는 컨테이너 내부 포트인 5432 고정이다.
  # 호스트에 매핑한 POSTGRES_PORT 와는 무관하다.
  url: postgresql+asyncpg://app:app@postgres:5432/app

  model_modules:
    - models.chat_message
    - models.chat_room
    - models.chat_turn_state
    - models.claim_chunk
    - models.claim_document
    - models.evidence
    - models.evidence_chunk
    - models.evidence_document
    - models.ingredient
    - models.ingredient_knowledge
    - models.nia_case_document
    - models.product
    - models.product_ingredient
    - models.rag_chunk
    - models.user

redis:
  # 마찬가지로 서비스 이름 redis.
  url: redis://redis:6379/0
  max_connections: 20
  decode_responses: true

app:
  title: skincare

auth:
  session_ttl_seconds: 1209600
  cookie_name: session_id
  # HTTPS 뒤에 두면 반드시 true 로 바꾼다. http 로 그대로 노출한다면 false 여야 쿠키가 붙는다.
  cookie_secure: false
  cookie_samesite: lax
  cookie_domain: null

# 배포 컨테이너는 MFDS 수집 스크립트를 실행하지 않으므로 mfds 블록이 없어도 된다.
# 컨테이너 안에서 그 스크립트를 돌릴 일이 생기면 그때 추가한다.

# 실제 키는 이 샘플이 아니라 배포 호스트의 config.yaml에만 입력한다.
openai:
  api_key: "OpenAI API 키"
  chat_model: gpt-4o-mini
  timeout_seconds: 30
  max_retries: 1

# 채팅(POST /chat)은 2-Layer Claim/Evidence 경로(BGE-M3, 1024차원)로만 조립된다(ChatAgentAssembler).
# embedding.provider를 openai로 두면 저장된 벡터(1024차원)와 차원이 달라 조립이 즉시 RuntimeError로
# 실패한다. openai_* 키는 구형 rag_chunk(1536차원) 단일 경로 스크립트에서만 쓰는 값으로 남겨 둔다.
agent:
  chat:
    # openai | ollama | local
    provider: openai
    local:
      base_url: http://localhost:11434/v1
      model: "qwen 3.5:9B"
      timeout_seconds: 60
      max_retries: 1
  embedding:
    # 채팅 조립은 local(BGE-M3)만 허용한다. openai는 구형 rag_chunk 스크립트 전용이다.
    provider: local
    openai_model: text-embedding-3-small
    openai_dimensions: 1536
    openai_batch_size: 100
    model: BAAI/bge-m3
    device: null
    batch_size: 16
    # 배포 컨테이너가 재생성될 때마다 모델을 다시 받지 않으려면 볼륨 마운트 경로를 지정한다.
    # 볼륨 추가는 docker-compose.prod.yml 변경(공용 설정)이라 먼저 확인받는다.
    cache_folder: null
    local_files_only: false
  reranker:
    model: BAAI/bge-reranker-v2-m3
    device: null
    batch_size: 8
    max_length: 512
    cache_folder: null
    local_files_only: false
  retrieval:
    # 선택 항목이다. 피부 고민형 기본 경로(NIA Case 검색)는 이 값이 없어도 조립된다.
    # 오프라인 Claim 비교 경로를 배포에서 쓸 때만 실제 적재된 active annotation version으로 채운다.
    claim_annotation_version: null
    free_text_min_vector_similarity: 0.45
    rrf_k: 60
    rerank_candidate_limit: 30
