# 파이썬이 만드는 파일
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# 가상 환경
.venv/
.venv*/

# 비밀 값이 들어가는 설정 파일. 절대 커밋하지 않는다.
# 대신 값이 비어 있는 config.yaml.sample 과 .env.example 을 커밋한다.
config.yaml
.env
.env.*
!.env.example
*.pem
*.key

# 검사와 테스트 도구가 만드는 캐시
.pytest_cache/
.ruff_cache/
.pyrefly_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# 에디터, 운영체제
.DS_Store
.vscode/
.idea/
# Claude Code 로컬 설정(launch.json 등). 개인 실행 환경이라 공유하지 않는다.
.claude/
*.swp
Thumbs.db
Desktop.ini
ehthumbs.db
.DS_Store
.Rhistory

# 로컬에서만 쓰는 파일
*.log
*.sqlite3
*.db
tmp/
scratch/

# 프론트엔드 (스택을 정한 뒤 필요하면 더 넣는다)
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
# Vite 의존성 최적화 캐시, TS 증분 컴파일 캐시. 둘 다 빌드 시 다시 생성된다.
frontend/.vite/
*.tsbuildinfo

# RAG 관련 로컬 데이터. 용량이 크고 다시 만들 수 있으므로 커밋하지 않는다.
data/
# 데이터 처리 코드만 추적하고 대용량 원본·산출물은 계속 제외한다.
!/data/
/data/*
!/data/__init__.py
!/data/scripts/
/data/scripts/*
!/data/scripts/*.py
uploads/
models_cache/
*.faiss

# docs/ 아래 문서는 언제나 커밋한다.
# 위의 data/ 규칙이 경로와 무관하게 docs/data/ 까지 잡아서 문서가 빠지는 사고가 있었다.
!docs/
!docs/**


# YK
KG_skincare/
