# config.yaml.sample -> config.yaml 으로 복사한 뒤 실제 값을 넣는다.
# config.yaml 은 반드시 .gitignore 에 넣는다.

database:
  # SQLAlchemy async URL. 런타임 연결이자 마이그레이션 대상이다.
  url: postgresql+asyncpg://app:app@localhost:5432/app

  # Alembic autogenerate 전에 import 할 모델 모듈. 여기에 없는 모델은
  # metadata 에 올라오지 않아 마이그레이션에 나타나지 않는다.
  # models/ 에 파일을 추가할 때마다 여기에도 모듈 경로를 추가한다.
  model_modules:
    - models.chat_message
    - models.chat_room
    - models.chat_turn_state
    - models.claim_chunk
    - models.claim_document
    - models.evidence
    - models.evidence_chunk
    - models.evidence_document
    - models.ingredient
    - models.ingredient_knowledge
    - models.nia_case_document
    - models.product
    - models.product_ingredient
    - models.rag_chunk
    - models.user

# 블록 전체를 지우면 아래 기본값이 그대로 쓰인다.
redis:
  url: redis://localhost:6379/0
  # 연결 풀이 동시에 여는 최대 연결 수.
  max_connections: 20
  # True 면 응답이 str, False 면 bytes.
  decode_responses: true

# 블록 전체를 지우면 아래 기본값이 그대로 쓰인다.
app:
  # OpenAPI 문서와 /docs 상단에 표시되는 이름.
  title: skincare

# 로그인 세션 설정. 블록 전체를 지우면 아래 기본값이 그대로 쓰인다.
auth:
  # 세션 만료 시간(초). 기본 14일. 이 시간이 지나면 Redis 키가 사라져 재로그인이 필요하다.
  session_ttl_seconds: 1209600
  # 세션 ID 를 담는 쿠키 이름.
  cookie_name: session_id
  # HTTPS 에서만 쿠키를 보낼지 여부. 로컬 http 개발은 false, 배포는 반드시 true.
  cookie_secure: false
  # 크로스 사이트 요청에 쿠키를 붙일지. lax|strict|none. none 은 cookie_secure=true 필수.
  cookie_samesite: lax
  # 쿠키를 공유할 도메인. 비우면 요청을 받은 호스트에만 한정된다.
  cookie_domain: null

# MFDS 연동 스크립트(scripts/import_mfds_restricted_ingredients.py)를 실행할 때만 필요하다.
# 블록이 없으면 해당 스크립트가 명확한 에러를 내고 종료한다.
mfds:
  service_key: "공공데이터포털에서 발급받은 서비스키"

# Intent·답변 생성과 OpenAI 임베딩을 실행할 때 사용한다. 리랭킹에는 사용하지 않는다.
# 블록이 없으면 Agent 조립이 명확한 에러를 내고 종료한다.
openai:
  api_key: "OpenAI API 키"
  chat_model: gpt-4o-mini
  timeout_seconds: 30
  max_retries: 1

# 채팅(POST /chat)은 2-Layer Claim/Evidence 경로(BGE-M3, 1024차원)로만 조립된다(ChatAgentAssembler).
# embedding.provider를 openai로 두면 저장된 벡터(1024차원)와 차원이 달라 조립이 즉시 RuntimeError로
# 실패한다. openai_* 키는 구형 rag_chunk(1536차원) 단일 경로 스크립트에서만 쓰는 값으로 남겨 둔다.
# 리랭커는 항상 로컬에서 실행하며 모델 파일은 최초 실행 때 캐시에 내려받는다.
agent:
  chat:
    # openai | ollama | local. local/ollama는 base_url의 OpenAI 호환 서버를 호출한다.
    provider: openai
    local:
      base_url: http://localhost:11434/v1
      model: "qwen 3.5:9B"
      timeout_seconds: 60
      max_retries: 1
  embedding:
    # 채팅 조립은 local(BGE-M3)만 허용한다. openai는 구형 rag_chunk 스크립트 전용이다.
    provider: local
    openai_model: text-embedding-3-small
    openai_dimensions: 1536
    openai_batch_size: 100
    model: BAAI/bge-m3
    device: null
    batch_size: 16
    cache_folder: null
    local_files_only: false
  reranker:
    model: BAAI/bge-reranker-v2-m3
    device: null
    batch_size: 8
    max_length: 512
    cache_folder: null
    local_files_only: false
  retrieval:
    # 선택 항목이다. 피부 고민형 기본 경로(NIA Case 검색)는 이 값이 없어도 조립된다.
    # 오프라인 Claim 비교 경로를 별도로 쓸 때만 실제 적재된 annotation run으로 채운다.
    claim_annotation_version: null
    # BGE-M3 기준 검증값이 아직 확정 전이라 임시값이다. 후속 평가에서 바뀔 수 있다(계약 9.6절).
    free_text_min_vector_similarity: 0.45
    rrf_k: 60
    rerank_candidate_limit: 30
